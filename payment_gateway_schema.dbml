Project payment_gateway {
  database_type: 'PostgreSQL'
  Note: '''
    DBML-схема фактической рабочей базы платежного шлюза.
    Описывает таблицы, которые создаются и используются Go-кодом проекта:
    платежи, возвраты, токены, мерчанты, маршрутизация, уведомления и логирование.

    В базе могут существовать дополнительные экспериментальные таблицы
    customers/transactions/payment_methods/payment_providers/etc.; они не являются
    основным runtime-хранилищем текущего шлюза.
  '''
}

Table merchants {
  id uuid [pk, default: `gen_random_uuid()`]
  merchant_id text [not null, unique, note: 'Внешний идентификатор мерчанта, используется в API и HMAC-auth']
  name text [not null]
  api_key_hash text [not null, note: 'SHA-256 hash от api_key; сам api_key не хранится']
  secret_key text [not null, note: 'HMAC secret; может быть зашифрован через Vault Transit: vault:v1:...']
  webhook_url text
  role text [not null, default: 'merchant', note: 'merchant, admin или auditor']
  active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    merchant_id [unique, name: 'idx_merchants_merchant_id_unique']
    (merchant_id, active) [name: 'idx_merchants_active']
  }
}

Table payment_transactions {
  id bigint [pk, increment]
  merchant_id text [not null]
  payment_id text [not null]
  idempotency_key text [not null]
  status text [not null]
  payload_json jsonb [not null, default: `'{}'::jsonb`, note: 'Последний PaymentResponse в JSONB']
  updated_at timestamptz [not null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (merchant_id, idempotency_key) [unique, name: 'payment_transactions_merchant_id_idempotency_key_key']
    (merchant_id, payment_id) [name: 'idx_payment_transactions_merchant_payment']
    (merchant_id, created_at) [name: 'idx_payment_transactions_merchant_created']
  }
}

Table payment_tokens {
  id bigint [pk, increment]
  merchant_id text [not null]
  payment_id text [not null]
  idempotency_key text [not null]
  token_hash text [not null, unique]
  token_preview text [not null]
  payment_method text [not null]
  masked_value text [note: 'Маска карты/кошелька; полный PAN/CVV не хранится']
  expires_at timestamptz [not null]
  created_at timestamptz [not null, default: `now()`]
  revoked_at timestamptz

  indexes {
    (merchant_id, payment_id) [unique, name: 'payment_tokens_merchant_id_payment_id_key']
    (merchant_id, payment_id) [name: 'idx_payment_tokens_merchant_payment']
    (merchant_id, idempotency_key) [name: 'idx_payment_tokens_idempotency']
    token_hash [unique, name: 'payment_tokens_token_hash_key']
    token_hash [name: 'idx_payment_tokens_hash']
    expires_at [name: 'idx_payment_tokens_expires_at']
  }
}

Table payment_refunds {
  id bigint [pk, increment]
  merchant_id text [not null]
  refund_id text [not null]
  payment_id text [not null]
  idempotency_key text [not null]
  status text [not null, note: 'PROCESS_REFUND, SUCCESS_REFUND, FAIL_REFUND']
  amount numeric(18, 2) [not null]
  currency text [not null]
  entity_type text [not null]
  entity_id text [not null]
  refund_type text [not null]
  provider text
  payment_system text
  external_refund_id text
  provider_status text
  provider_error_code text
  provider_error_message text
  reason text
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    (merchant_id, refund_id) [unique, name: 'payment_refunds_merchant_id_refund_id_key']
    (merchant_id, idempotency_key) [unique, name: 'payment_refunds_merchant_id_idempotency_key_key']
    (merchant_id, payment_id) [name: 'idx_payment_refunds_merchant_payment']
  }
}

Table merchant_payment_routes {
  id bigint [pk, increment]
  merchant_id text [not null]
  payment_method text [not null]
  provider text [not null, note: 'yookassa, robokassa, payanyway, simulated, digital_ruble и т.п.']
  payment_system text [not null]
  priority integer [not null, default: 100]
  active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (merchant_id, payment_method, provider) [unique, name: 'merchant_payment_routes_merchant_id_payment_method_provider_key']
    (merchant_id, payment_method, active, priority) [name: 'idx_merchant_payment_routes_lookup']
    provider [name: 'idx_merchant_payment_routes_provider']
  }
}

Table notification_deliveries {
  id uuid [pk, default: `gen_random_uuid()`]
  delivery_id text [not null, unique]
  merchant_id text [not null]
  payment_id text [not null]
  idempotency_key text
  event_type text [not null]
  callback_url text [not null]
  status_code integer
  success boolean [not null, default: false]
  error_message text
  created_at timestamptz [not null, default: `now()`]

  indexes {
    delivery_id [unique, name: 'notification_deliveries_delivery_id_key']
    (merchant_id, payment_id) [name: 'idx_notification_deliveries_payment']
    created_at [name: 'idx_notification_deliveries_created_at']
  }
}

Table services {
  id uuid [pk, default: `gen_random_uuid()`]
  code varchar(100) [not null, unique]
  name varchar(255) [not null]
  description text

  indexes {
    code [unique, name: 'services_code_key']
  }
}

Table log_events {
  id uuid [pk, default: `gen_random_uuid()`]
  code varchar(100) [not null, unique]
  name varchar(255) [not null]
  description text

  indexes {
    code [unique, name: 'log_events_code_key']
  }
}

Table log_entries {
  id uuid [pk, default: `gen_random_uuid()`]
  timestamp timestamptz [not null, default: `now()`]
  level varchar(20) [not null]
  message text [not null]
  environment varchar(50) [not null, default: 'dev']
  correlation_id text
  merchant_id varchar(255)
  payment_id varchar(255)
  idempotency_key varchar(255)
  current_status varchar(50)
  service_id uuid [not null]
  event_id uuid [not null]

  indexes {
    correlation_id [name: 'idx_log_entries_correlation_id']
    payment_id [name: 'idx_log_entries_payment_id']
    idempotency_key [name: 'idx_log_entries_idempotency_key']
    timestamp [name: 'idx_log_entries_timestamp']
    service_id [name: 'idx_log_entries_service_id']
    event_id [name: 'idx_log_entries_event_id']
  }
}

Table log_context {
  id uuid [pk, default: `gen_random_uuid()`]
  log_entry_id uuid [not null]
  key varchar(100) [not null]
  value text

  indexes {
    (log_entry_id, key) [unique, name: 'idx_log_context_unique_key']
  }
}

Ref: log_entries.service_id > services.id
Ref: log_entries.event_id > log_events.id
Ref: log_context.log_entry_id > log_entries.id [delete: cascade]

// Logical relationships used by the application code.
// They are stored as text IDs and are not physical PostgreSQL foreign keys.
Ref: payment_transactions.merchant_id > merchants.merchant_id
Ref: payment_tokens.merchant_id > merchants.merchant_id
Ref: payment_refunds.merchant_id > merchants.merchant_id
Ref: merchant_payment_routes.merchant_id > merchants.merchant_id
Ref: notification_deliveries.merchant_id > merchants.merchant_id
Ref: payment_tokens.payment_id > payment_transactions.payment_id
Ref: payment_refunds.payment_id > payment_transactions.payment_id
Ref: notification_deliveries.payment_id > payment_transactions.payment_id
