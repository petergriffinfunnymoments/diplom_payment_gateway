{
  "info": {
    "_postman_id": "payment-gateway-collection",
    "name": "Payment Gateway API",
    "description": "Main payment gateway operations: health, payments, status checks and refunds. Merchant HMAC auth is calculated automatically by the collection pre-request script.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "noauth"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "function currentPathWithQuery() {",
          "  let path = pm.request.url.getPathWithQuery ? pm.request.url.getPathWithQuery() : pm.request.url.getPath();",
          "  return pm.variables.replaceIn(path);",
          "}",
          "",
          "function renderedRawBody() {",
          "  if (pm.request.body && pm.request.body.mode === 'raw') {",
          "    return pm.variables.replaceIn(pm.request.body.raw || '');",
          "  }",
          "  return '';",
          "}",
          "",
          "function prepareDynamicPaymentVariables(method, pathWithQuery) {",
          "  const now = new Date();",
          "  const nowMs = now.getTime();",
          "",
          "  if (method === 'POST' && pathWithQuery === '/payments') {",
          "    pm.environment.set('payment_id', 'pay_' + nowMs);",
          "    pm.environment.set('idempotency_key', 'idem_' + nowMs);",
          "    pm.environment.set('created_at', now.toISOString());",
          "  }",
          "",
          "  if (method === 'POST' && pathWithQuery === '/refunds/full/create') {",
          "    pm.environment.set('refund_idempotency_key', 'refund_full_' + nowMs);",
          "  }",
          "",
          "  if (method === 'POST' && pathWithQuery === '/refunds/partial/create') {",
          "    pm.environment.set('refund_idempotency_key', 'refund_partial_' + nowMs);",
          "  }",
          "}",
          "",
          "function authorizeMerchantRequest() {",
          "  const merchantId = pm.environment.get('merchant_id') || 'merchant_12345';",
          "  const apiKey = pm.environment.get('api_key') || 'demo_api_key';",
          "  const secretKey = pm.environment.get('secret_key') || 'demo_secret_key';",
          "  const method = pm.request.method.toUpperCase();",
          "  const pathWithQuery = currentPathWithQuery();",
          "",
          "  prepareDynamicPaymentVariables(method, pathWithQuery);",
          "",
          "  const timestamp = Math.floor(Date.now() / 1000).toString();",
          "  const body = renderedRawBody();",
          "  const bodyHash = CryptoJS.SHA256(body).toString(CryptoJS.enc.Hex);",
          "  const canonical = `${timestamp}.${method}.${pathWithQuery}.${bodyHash}`;",
          "  const signature = CryptoJS.HmacSHA256(canonical, secretKey).toString(CryptoJS.enc.Hex);",
          "",
          "  pm.environment.set('last_auth_path', pathWithQuery);",
          "  pm.environment.set('last_body_sha256', bodyHash);",
          "  pm.environment.set('last_canonical', canonical);",
          "  pm.environment.set('last_signature', signature);",
          "  console.log('merchant auth canonical:', canonical);",
          "  console.log('merchant auth signature:', signature);",
          "",
          "  pm.request.headers.upsert({ key: 'X-Merchant-ID', value: merchantId });",
          "  pm.request.headers.upsert({ key: 'X-API-Key', value: apiKey });",
          "  pm.request.headers.upsert({ key: 'X-Timestamp', value: timestamp });",
          "  pm.request.headers.upsert({ key: 'X-Signature', value: signature });",
          "}",
          "",
          "authorizeMerchantRequest();"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "(function () {",
          "  let json;",
          "  try {",
          "    json = pm.response.json();",
          "  } catch (e) {",
          "    return;",
          "  }",
          "",
          "  const isPaymentLike = !!(json && (json.payment_info || json.transaction_details || json.current_status || json.error));",
          "  const isGatewayError = !!(json && (json.code || (json.error && json.error.code)));",
          "  if (!isPaymentLike && !isGatewayError) {",
          "    return;",
          "  }",
          "",
          "  const template = `",
          "<html>",
          "<head>",
          "<style>",
          "  body { font-family: 'Segoe UI', Arial, sans-serif; background: #f3f5f8; margin: 0; padding: 16px; color: #20232a; }",
          "  .topline { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 14px; }",
          "  .title { font-size: 18px; font-weight: 800; color: #243042; }",
          "  .meta { color: #697386; font-size: 12px; }",
          "  .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }",
          "  .card { background: #fff; border: 1px solid #e4e8ef; border-radius: 8px; box-shadow: 0 2px 10px rgba(19, 33, 68, 0.06); padding: 18px 20px; }",
          "  .wide { grid-column: 1 / -1; }",
          "  h2 { font-size: 13px; font-weight: 800; color: #4b5870; margin: 0 0 12px 0; letter-spacing: 0.04em; text-transform: uppercase; border-bottom: 1px solid #e7ebf2; padding-bottom: 8px; }",
          "  table { width: 100%; border-collapse: collapse; }",
          "  td { padding: 7px 8px; font-size: 13px; vertical-align: top; border-bottom: 1px solid #f0f2f6; }",
          "  td:first-child { color: #7a8496; font-weight: 700; width: 35%; white-space: nowrap; }",
          "  td:last-child { color: #20232a; word-break: break-word; }",
          "  .badge { display: inline-block; padding: 3px 10px; border-radius: 999px; font-size: 12px; font-weight: 800; letter-spacing: 0.03em; }",
          "  .badge-green { background: #dff7e9; color: #167044; }",
          "  .badge-yellow { background: #fff3c4; color: #8a6400; }",
          "  .badge-red { background: #fde2e2; color: #b42318; }",
          "  .badge-grey { background: #e8edf4; color: #4f5d72; }",
          "  code { font-family: Consolas, 'Courier New', monospace; font-size: 12px; background: #f5f7fa; padding: 6px 8px; border-radius: 6px; display: block; white-space: pre-wrap; word-break: break-all; }",
          "  .architecture { background: #f8fafc; border-radius: 8px; padding: 18px; overflow: auto; border: 1px solid #e2e8f0; box-shadow: inset 0 0 0 1px rgba(255,255,255,0.7); }",
          "  .diagram-canvas { position: relative; width: 1180px; height: 560px; background: #f8fafc; color: #0f172a; font-family: Inter, 'Segoe UI', Arial, sans-serif; }",
          "  .diagram-node { position: absolute; box-sizing: border-box; background: #fff; border: 2px solid #cbd5e1; border-radius: 8px; padding: 12px 14px; text-align: center; z-index: 3; box-shadow: 0 10px 24px rgba(15, 23, 42, 0.08); display: flex; flex-direction: column; align-items: center; justify-content: center; overflow: hidden; }",
          "  .diagram-node .module-title { font-size: 15px; font-weight: 800; line-height: 1.16; color: #0f172a; margin-bottom: 5px; }",
          "  .diagram-node .module-hint { font-size: 12px; line-height: 1.28; color: #475569; }",
          "  .diagram-node.database { border-radius: 0 0 50% 50% / 0 0 16% 16%; padding-top: 31px; }",
          "  .diagram-node.database::before { content: ''; position: absolute; left: -2px; right: -2px; top: -16px; height: 30px; background: inherit; border: 2px solid; border-color: inherit; border-radius: 50%; box-sizing: border-box; }",
          "  .diagram-node.state-ok { background: #f0fdf4; border-color: #22a06b; box-shadow: 0 10px 24px rgba(34, 160, 107, 0.13), 0 0 0 3px rgba(34, 160, 107, 0.12); }",
          "  .diagram-node.state-stop { background: #fff5f5; border-color: #d92d20; box-shadow: 0 10px 24px rgba(217, 45, 32, 0.14), 0 0 0 3px rgba(217, 45, 32, 0.14); }",
          "  .diagram-node.state-idle { border-color: #cbd5e1; }",
          "  .diagram-line { position: absolute; z-index: 1; color: #94a3b8; background: currentColor; }",
          "  .diagram-line.flow-ok { color: #22a06b; }",
          "  .diagram-line.flow-stop { color: #d92d20; }",
          "  .line-h-right, .line-h-left { height: 3px; }",
          "  .line-v-down, .line-v-up { width: 3px; }",
          "  .line-h-right::after, .line-h-left::after, .line-v-down::after, .line-v-up::after { content: ''; position: absolute; width: 0; height: 0; border: 7px solid transparent; }",
          "  .line-h-right::after { right: -12px; top: -6px; border-left-color: currentColor; }",
          "  .line-h-left::after { left: -12px; top: -6px; border-right-color: currentColor; }",
          "  .line-v-down::after { left: -6px; bottom: -12px; border-top-color: currentColor; }",
          "  .line-v-up::after { left: -6px; top: -12px; border-bottom-color: currentColor; }",
          "  .line-plain::after { display: none; }",
          "  .flow-label { position: absolute; z-index: 4; max-width: 190px; background: #fff; border: 1px solid #dbe4ef; color: #334155; padding: 4px 7px; border-radius: 6px; font-size: 11px; font-weight: 650; line-height: 1.22; text-align: center; box-sizing: border-box; box-shadow: 0 6px 14px rgba(15, 23, 42, 0.07); }",
          "  .legend { display: flex; gap: 12px; flex-wrap: wrap; margin: 12px 0 0; color: #667085; font-size: 12px; }",
          "  .legend span { display: inline-flex; align-items: center; gap: 6px; }",
          "  .dot { width: 10px; height: 10px; border-radius: 50%; display: inline-block; }",
          "  .dot.green { background: #22a06b; }",
          "  .dot.red { background: #d92d20; }",
          "  .dot.grey { background: #98a2b3; }",
          "  .error { color: #b42318; font-weight: 700; }",
          "  @media (max-width: 760px) { .grid { grid-template-columns: 1fr; } .architecture { padding: 10px; } .diagram-canvas { transform: scale(0.72); transform-origin: top left; margin-right: -330px; margin-bottom: -150px; } .topline { align-items: flex-start; flex-direction: column; } td:first-child { width: 42%; white-space: normal; } }",
          "</style>",
          "</head>",
          "<body>",
          "  <div class='topline'>",
          "    <div class='title'>Payment Gateway Response</div>",
          "    <div class='meta'>HTTP {{httpStatus}} - {{requestName}}</div>",
          "  </div>",
          "",
          "  <div class='grid'>",
          "    <div class='card'>",
          "      <h2>Payment Summary</h2>",
          "      <table>",
          "        <tr><td>Payment ID</td><td>{{paymentId}}</td></tr>",
          "        <tr><td>Merchant ID</td><td>{{merchantId}}</td></tr>",
          "        <tr><td>Idempotency Key</td><td>{{idempotencyKey}}</td></tr>",
          "        <tr><td>Status</td><td>{{{statusBadge}}}</td></tr>",
          "        <tr><td>Amount</td><td>{{amount}}</td></tr>",
          "        <tr><td>Payment Method</td><td>{{paymentMethod}}</td></tr>",
          "        <tr><td>Description</td><td>{{description}}</td></tr>",
          "        <tr><td>Created At</td><td>{{createdAt}}</td></tr>",
          "        <tr><td>Updated At</td><td>{{updatedAt}}</td></tr>",
          "        <tr><td>Error</td><td>{{{errorText}}}</td></tr>",
          "      </table>",
          "    </div>",
          "",
          "    <div class='card'>",
          "      <h2>Customer Data</h2>",
          "      <table>",
          "        <tr><td>Email</td><td>{{custEmail}}</td></tr>",
          "        <tr><td>Phone</td><td>{{custPhone}}</td></tr>",
          "        <tr><td>Card Number</td><td>{{custCard}}</td></tr>",
          "        <tr><td>Card Date</td><td>{{custCardDate}}</td></tr>",
          "        <tr><td>Digital Wallet ID</td><td>{{custWalletId}}</td></tr>",
          "        <tr><td>Digital Ruble Wallet ID</td><td>{{custDrWalletId}}</td></tr>",
          "        <tr><td>Digital Ruble Account</td><td>{{custDrAccount}}</td></tr>",
          "        <tr><td>Digital Ruble Identifier</td><td>{{custDrIdentifier}}</td></tr>",
          "      </table>",
          "    </div>",
          "",
          "    <div class='card wide'>",
          "      <h2>Диаграмма потока платежа</h2>",
          "      <div class='architecture'>{{{architectureHtml}}}</div>",
          "      <div class='legend'>",
          "        <span><i class='dot green'></i>модуль выполнен</span>",
          "        <span><i class='dot red'></i>модуль остановил транзакцию</span>",
          "        <span><i class='dot grey'></i>не достигнут или неизвестно</span>",
          "      </div>",
          "    </div>",
          "",
          "    <div class='card wide'>",
          "      <h2>Transaction Details</h2>",
          "      <table>",
          "        <tr><td>External Transaction ID</td><td>{{txExternalId}}</td></tr>",
          "        <tr><td>Payment System</td><td>{{txPaymentSystem}}</td></tr>",
          "        <tr><td>Provider Status</td><td>{{txProviderStatus}}</td></tr>",
          "        <tr><td>Payment URL</td><td>{{{txPaymentUrl}}}</td></tr>",
          "        <tr><td>Token Preview</td><td>{{txTokenPreview}}</td></tr>",
          "        <tr><td>Fraud Check Result</td><td>{{{fraudBadge}}}</td></tr>",
          "        <tr><td>Retry Count</td><td>{{txRetryCount}}</td></tr>",
          "        <tr><td>Provider Error</td><td>{{txProviderError}}</td></tr>",
          "        <tr><td>Cancellation</td><td>{{txCancellation}}</td></tr>",
          "        <tr><td>Participant Bank</td><td>{{txParticipantBank}}</td></tr>",
          "        <tr><td>Schema Version</td><td>{{txSchemaVersion}}</td></tr>",
          "        <tr><td>Settlement Hint</td><td>{{txSettlementHint}}</td></tr>",
          "        <tr><td>QR ID</td><td>{{txQrId}}</td></tr>",
          "        <tr><td>QR Expires At</td><td>{{txQrExpiresAt}}</td></tr>",
          "        <tr><td>QR Payload</td><td><code>{{txQrPayload}}</code></td></tr>",
          "      </table>",
          "    </div>",
          "  </div>",
          "</body>",
          "</html>",
          "  `;",
          "",
          "  const modules = [",
          "    { key: 'api', type: 'gateway', x: 40, y: 70, w: 210, h: 90, title: 'API-шлюз', hint: 'Прием запроса, merchant auth, HMAC-подпись' },",
          "    { key: 'validation', type: 'gateway', x: 290, y: 70, w: 230, h: 90, title: 'Валидация платежных данных', hint: 'Проверка суммы, валюты и обязательных полей' },",
          "    { key: 'orchestrator', type: 'gateway', x: 560, y: 55, w: 250, h: 120, title: 'Оркестратор платежей', hint: 'Управляет жизненным циклом и маршрутом обработки' },",
          "    { key: 'antifraud', type: 'gateway', x: 870, y: 70, w: 230, h: 90, title: 'Антифрод', hint: 'Оценка риска и блокировка подозрительных платежей' },",
          "    { key: 'tokenizer', type: 'gateway', x: 560, y: 250, w: 250, h: 95, title: 'Модуль токенизации', hint: 'Создание внутреннего токена без хранения чувствительных данных' },",
          "    { key: 'adapter', type: 'gateway', x: 870, y: 250, w: 230, h: 95, title: 'Адаптер платежной системы', hint: 'Вызов выбранного provider adapter' },",
          "    { key: 'database', type: 'gateway database', x: 130, y: 430, w: 220, h: 96, title: 'База данных', hint: 'Сохранение состояния платежа и payload' },",
          "    { key: 'logging', type: 'gateway', x: 480, y: 430, w: 220, h: 90, title: 'Модуль логирования', hint: 'Фиксация событий жизненного цикла платежа' },",
          "    { key: 'notifications', type: 'gateway', x: 830, y: 430, w: 240, h: 90, title: 'Сервис уведомлений', hint: 'Webhook интернет-магазину о результате платежа' }",
          "  ];",
          "",
          "  function valueOrNA(value) {",
          "    return value === undefined || value === null || value === '' ? 'N/A' : String(value);",
          "  }",
          "",
          "  function escapeHtml(value) {",
          "    return valueOrNA(value).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/'/g, '&#39;');",
          "  }",
          "",
          "  function badge(value, tone) {",
          "    return `<span class='badge badge-${tone}'>${escapeHtml(value)}</span>`;",
          "  }",
          "",
          "  function statusTone(status) {",
          "    const s = String(status || '').toUpperCase();",
          "    if (['CAPTURED', 'AUTHORIZED', 'VOIDED'].includes(s)) return 'green';",
          "    if (['PENDING', 'CREATED', 'CAPTURE_REQUESTED', 'VOID_REQUESTED'].includes(s)) return 'yellow';",
          "    if (['DECLINED', 'FAILED', 'CANCELLED', 'VOID_FAILED'].includes(s)) return 'red';",
          "    return 'grey';",
          "  }",
          "",
          "  function fraudTone(result) {",
          "    const r = String(result || '').toUpperCase();",
          "    if (r === 'PASSED') return 'green';",
          "    if (r === 'REVIEW') return 'yellow';",
          "    if (['BLOCKED', 'FAILED', 'ERROR'].includes(r)) return 'red';",
          "    return 'grey';",
          "  }",
          "",
          "  function getErrorCode(response) {",
          "    if (response && response.error && response.error.code) return String(response.error.code);",
          "    if (response && response.code) return String(response.code);",
          "    return '';",
          "  }",
          "",
          "  function getErrorMessage(response) {",
          "    if (response && response.error && response.error.message) return String(response.error.message);",
          "    if (response && response.message) return String(response.message);",
          "    return '';",
          "  }",
          "",
          "  function architecture(response) {",
          "    const states = {};",
          "    const hints = {};",
          "    modules.forEach(function (module) { states[module.key] = 'idle'; });",
          "    const ok = function () { Array.prototype.slice.call(arguments).forEach(function (key) { states[key] = 'ok'; }); };",
          "    const stop = function (key, hint) { states[key] = 'stop'; if (hint) hints[key] = hint; };",
          "    const code = getErrorCode(response).toUpperCase();",
          "    const status = String(response.current_status || '').toUpperCase();",
          "    const tx = response.transaction_details || {};",
          "    const fraud = String(tx.fraud_check_result || '').toUpperCase();",
          "    const paymentLike = !!(response.payment_info || response.transaction_details || response.current_status);",
          "",
          "    if (code === 'AUTHENTICATION_ERROR' || pm.response.code === 401) {",
          "      stop('api', getErrorMessage(response) || 'Ошибка merchant auth');",
          "      return renderArchitecture(states, hints);",
          "    }",
          "",
          "    if (!paymentLike) {",
          "      ok('api');",
          "      if (code === 'PAYMENT_NOT_FOUND') {",
          "        stop('database', 'Платеж не найден в payment_transactions');",
          "        ok('logging');",
          "      } else if (code.indexOf('VALIDATION') >= 0) {",
          "        stop('validation', getErrorMessage(response) || code);",
          "      } else if (code) {",
          "        stop('orchestrator', getErrorMessage(response) || code);",
          "      }",
          "      return renderArchitecture(states, hints);",
          "    }",
          "",
          "    ok('api', 'validation', 'orchestrator');",
          "",
          "    if (code.indexOf('VALIDATION') >= 0) {",
          "      stop('validation', getErrorMessage(response) || code);",
          "      ok('logging', 'notifications', 'database');",
          "      return renderArchitecture(states, hints);",
          "    }",
          "",
          "    if (code.indexOf('ANTIFRAUD') >= 0 || fraud === 'BLOCKED') {",
          "      stop('antifraud', getErrorMessage(response) || 'Платеж заблокирован антифродом');",
          "      ok('logging', 'notifications', 'database');",
          "      return renderArchitecture(states, hints);",
          "    }",
          "",
          "    ok('antifraud');",
          "",
          "    if (code.indexOf('ROUTING') >= 0) {",
          "      stop('orchestrator', getErrorMessage(response) || 'Не найден маршрут платежа');",
          "      ok('logging', 'notifications', 'database');",
          "      return renderArchitecture(states, hints);",
          "    }",
          "",
          "    if (code.indexOf('TOKEN') >= 0) {",
          "      stop('tokenizer', getErrorMessage(response) || 'Ошибка токенизации');",
          "      ok('logging', 'notifications', 'database');",
          "      return renderArchitecture(states, hints);",
          "    }",
          "",
          "    ok('tokenizer');",
          "",
          "    if (code.indexOf('ADAPTER') >= 0 || code === 'PAYMENT_DECLINED' || ['DECLINED', 'FAILED', 'CANCELLED'].includes(status)) {",
          "      stop('adapter', getErrorMessage(response) || tx.provider_error_message || 'Провайдер вернул отказ или ошибку');",
          "      ok('logging', 'notifications', 'database');",
          "      return renderArchitecture(states, hints);",
          "    }",
          "",
          "    const adapterTouched = !!(tx.payment_system || tx.external_transaction_id || tx.provider_status || tx.payment_url || tx.qr_id);",
          "    if (adapterTouched || ['PENDING', 'CAPTURED', 'AUTHORIZED', 'CAPTURE_REQUESTED'].includes(status)) {",
          "      ok('adapter', 'notifications', 'logging', 'database');",
          "    } else {",
          "      ok('logging', 'database');",
          "    }",
          "    return renderArchitecture(states, hints);",
          "  }",
          "",
          "  function renderArchitecture(states, hints) {",
          "    const flows = [",
          "      { kind: 'line', dir: 'h-right', x: 250, y: 115, w: 40, from: 'api', to: 'validation' },",
          "      { kind: 'label', x: 245, y: 86, w: 95, text: 'запрос платежа' },",
          "      { kind: 'line', dir: 'h-right', x: 520, y: 115, w: 40, from: 'validation', to: 'orchestrator' },",
          "      { kind: 'label', x: 506, y: 86, w: 110, text: 'валидные данные' },",
          "      { kind: 'line', dir: 'h-right', x: 810, y: 105, w: 60, from: 'orchestrator', to: 'antifraud' },",
          "      { kind: 'label', x: 818, y: 76, w: 118, text: 'проверка риска' },",
          "      { kind: 'line', dir: 'h-left', x: 810, y: 150, w: 60, from: 'antifraud', to: 'orchestrator' },",
          "      { kind: 'label', x: 818, y: 154, w: 118, text: 'результат проверки' },",
          "      { kind: 'line', dir: 'v-down', x: 685, y: 175, h: 75, from: 'orchestrator', to: 'tokenizer' },",
          "      { kind: 'label', x: 700, y: 202, w: 132, text: 'данные для токена' },",
          "      { kind: 'line', dir: 'h-right', x: 810, y: 298, w: 60, from: 'tokenizer', to: 'adapter' },",
          "      { kind: 'label', x: 812, y: 270, w: 120, text: 'внутренний токен' },",
          "      { kind: 'line', dir: 'v-up', x: 985, y: 175, h: 75, from: 'adapter', to: 'orchestrator', plain: true },",
          "      { kind: 'line', dir: 'h-left', x: 810, y: 175, w: 175, from: 'adapter', to: 'orchestrator' },",
          "      { kind: 'label', x: 872, y: 183, w: 142, text: 'результат адаптера' },",
          "      { kind: 'line', dir: 'v-down', x: 685, y: 175, h: 205, from: 'orchestrator', to: 'logging', plain: true },",
          "      { kind: 'line', dir: 'h-right', x: 240, y: 380, w: 710, from: 'orchestrator', to: 'logging', plain: true },",
          "      { kind: 'line', dir: 'v-down', x: 240, y: 380, h: 50, from: 'orchestrator', to: 'database' },",
          "      { kind: 'line', dir: 'v-down', x: 590, y: 380, h: 50, from: 'orchestrator', to: 'logging' },",
          "      { kind: 'line', dir: 'v-down', x: 950, y: 380, h: 50, from: 'orchestrator', to: 'notifications' },",
          "      { kind: 'label', x: 555, y: 390, w: 150, text: 'фиксация результата' }",
          "    ];",
          "    const flowHtml = flows.map(function (flow) {",
          "      return flow.kind === 'label' ? renderFlowLabel(flow) : renderFlowLine(flow, states);",
          "    }).join('');",
          "    const nodesHtml = modules.map(function (module) {",
          "      return renderNode(module, states, hints);",
          "    }).join('');",
          "    return `<div class='diagram-canvas'>${flowHtml}${nodesHtml}</div>`;",
          "  }",
          "",
          "  function renderNode(module, states, hints) {",
          "    const state = states[module.key] || 'idle';",
          "    const hint = hints[module.key] || module.hint;",
          "    const style = `left:${module.x}px;top:${module.y}px;width:${module.w}px;height:${module.h}px`;",
          "    return `<div class='diagram-node ${module.type} state-${state}' style='${style}'><div class='module-title'>${escapeHtml(module.title)}</div><div class='module-hint'>${escapeHtml(hint)}</div></div>`;",
          "  }",
          "",
          "  function renderFlowLabel(flow) {",
          "    return `<div class='flow-label' style='left:${flow.x}px;top:${flow.y}px;width:${flow.w}px'>${escapeHtml(flow.text)}</div>`;",
          "  }",
          "",
          "  function renderFlowLine(flow, states) {",
          "    const size = flow.dir.indexOf('h-') === 0 ? `width:${flow.w}px` : `height:${flow.h}px`;",
          "    const plain = flow.plain ? ' line-plain' : '';",
          "    return `<div class='diagram-line line-${flow.dir}${plain} ${flowClass(flow, states)}' style='left:${flow.x}px;top:${flow.y}px;${size}'></div>`;",
          "  }",
          "",
          "  function flowClass(flow, states) {",
          "    const fromState = states[flow.from] || 'idle';",
          "    const toState = states[flow.to] || 'idle';",
          "    if (fromState === 'stop' || toState === 'stop') return 'flow-stop';",
          "    if (fromState === 'ok' && toState === 'ok') return 'flow-ok';",
          "    return 'flow-idle';",
          "  }",
          "",
          "  function linkOrNA(url) {",
          "    if (!url) return 'N/A';",
          "    const safe = escapeHtml(url);",
          "    return `<a href='${safe}' target='_blank'>${safe}</a>`;",
          "  }",
          "",
          "  function createPayload(response) {",
          "    const pi = response.payment_info || {};",
          "    const amount = pi.amount || {};",
          "    const method = pi.payment_method_data || {};",
          "    const customer = pi.customer_data || {};",
          "    const tx = response.transaction_details || {};",
          "    const errorCode = getErrorCode(response);",
          "    const errorMessage = getErrorMessage(response);",
          "    const errorText = errorCode || errorMessage ? `<span class='error'>${escapeHtml(errorCode || 'ERROR')}: ${escapeHtml(errorMessage || 'N/A')}</span>` : 'N/A';",
          "",
          "    return {",
          "      httpStatus: pm.response.code,",
          "      requestName: pm.info.requestName,",
          "      paymentId: valueOrNA(response.id || response.payment_id),",
          "      merchantId: valueOrNA(response.merchant_id),",
          "      idempotencyKey: valueOrNA(response.idempotency_key),",
          "      statusBadge: badge(response.current_status || (errorCode ? 'ERROR' : 'N/A'), statusTone(response.current_status || (errorCode ? 'FAILED' : ''))),",
          "      amount: valueOrNA(amount.value) + (amount.currency ? ' ' + amount.currency : ''),",
          "      paymentMethod: valueOrNA(method.type),",
          "      description: valueOrNA(pi.description),",
          "      createdAt: valueOrNA(pi.created_at),",
          "      updatedAt: valueOrNA(pi.updated_at),",
          "      errorText: errorText,",
          "      architectureHtml: architecture(response),",
          "      custEmail: valueOrNA(customer.email),",
          "      custPhone: valueOrNA(customer.phone),",
          "      custCard: valueOrNA(customer.card_number),",
          "      custCardDate: valueOrNA(customer.card_date),",
          "      custWalletId: valueOrNA(customer.digital_wallet_id),",
          "      custDrWalletId: valueOrNA(customer.digital_ruble_wallet_id),",
          "      custDrAccount: valueOrNA(customer.digital_ruble_account),",
          "      custDrIdentifier: valueOrNA(customer.digital_ruble_identifier),",
          "      txExternalId: valueOrNA(tx.external_transaction_id),",
          "      txPaymentSystem: valueOrNA(tx.payment_system),",
          "      txProviderStatus: valueOrNA(tx.provider_status),",
          "      txPaymentUrl: linkOrNA(tx.payment_url),",
          "      txTokenPreview: valueOrNA(tx.token_preview),",
          "      fraudBadge: badge(tx.fraud_check_result || 'N/A', fraudTone(tx.fraud_check_result)),",
          "      txRetryCount: valueOrNA(tx.retry_count),",
          "      txProviderError: valueOrNA([tx.provider_error_code, tx.provider_error_message].filter(Boolean).join(': ')),",
          "      txCancellation: valueOrNA([tx.cancellation_party, tx.cancellation_reason].filter(Boolean).join(': ')),",
          "      txParticipantBank: valueOrNA(tx.participant_bank),",
          "      txSchemaVersion: valueOrNA(tx.schema_version),",
          "      txSettlementHint: valueOrNA(tx.settlement_hint),",
          "      txQrId: valueOrNA(tx.qr_id),",
          "      txQrExpiresAt: valueOrNA(tx.qr_expires_at),",
          "      txQrPayload: valueOrNA(tx.qr_payload)",
          "    };",
          "  }",
          "",
          "  pm.visualizer.set(template, createPayload(json));",
          "}());"
        ]
      }
    }
  ],
