        {
          "name": "GET /payments/{payment_id}",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/payments/{{payment_id}}?merchant_id={{merchant_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
